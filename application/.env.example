APP_NAME="RegistroEdu"
APP_ENV=local
APP_KEY=base64:MUdTZKZ0iQCozNd5kyAgbKsPsPzLakoYJtEVVxkeqQE=
APP_DEBUG=true
APP_TIMEZONE=America/Sao_Paulo
APP_URL=http://serve.hangmangame.pro:8000
APP_LOCALE=pt_BR
APP_FALLBACK_LOCALE=en

APP_FRONTEND_URL=http://serve.hangmangame.pro:5173

DB_CONNECTION=pgsql
DB_HOST=127.0.0.1
DB_PORT=5432
DB_DATABASE=registroedu
DB_USERNAME=postgres
DB_PASSWORD=your_db_password_here

REDIS_HOST=172.25.129.57
REDIS_PASSWORD=null
REDIS_PORT=6379
REDIS_DB=0

CACHE_STORE=redis
CACHE_PREFIX=registroedu_cache_

SESSION_DRIVER=database
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=null

JWT_SECRET=your_jwt_secret_here
JWT_ALGORITHM=HS256
JWT_ACCESS_TTL=60
JWT_REFRESH_TTL=20160

GOOGLE_CLIENT_ID=your_google_client_id_here
GOOGLE_CLIENT_SECRET=your_google_client_secret_here
GOOGLE_REDIRECT_URI="${APP_URL}/auth/google/callback"

PROXYCHECK_ENABLED=true
PROXYCHECK_API_KEY=your_proxycheck_api_key_here

SECURITY_LOGIN_BLOCK_PROXIES=true
SECURITY_LOGIN_BLOCK_VPNS=true
SECURITY_LOGIN_BLOCK_HIGH_RISK=true
SECURITY_LOGIN_RISK_THRESHOLD=85
SECURITY_DEFAULT_RISK_THRESHOLD=75
SECURITY_DEVELOPMENT_BYPASS_LOCALHOST=true

SECURITY_IP_WHITELIST="0.0.0.0/0"

LOG_CHANNEL=stack
LOG_STACK=single
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=debug

MAIL_MAILER=smtp
MAIL_HOST=127.0.0.1
MAIL_PORT=2525
MAIL_USERNAME=null
MAIL_PASSWORD=null
MAIL_ENCRYPTION=null
MAIL_FROM_ADDRESS="hello@example.com"
MAIL_FROM_NAME="${APP_NAME}"
